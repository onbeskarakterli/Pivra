@@ -0,0 +1,36 @@
+/* Experimental video-display policy; not a change to image CICP semantics.
+ * BT.1886 ideal-black reference display (Lb=0): L = V^2.4.
+ * Only explicitly tagged, already range-expanded BT.709 RGB8 is eligible.
+ * This header accompanies an opt-in GTK backend experiment, not Pivra's build.
+ */
+#pragma once
+#include <gst/video/video.h>
+#include <math.h>
+
+static inline gboolean
+gtk_gst_bt1886_eligible (const GstVideoInfo *info)
+{
+  const GstVideoColorimetry *c = &info->colorimetry;
+  return GST_VIDEO_INFO_FORMAT (info) == GST_VIDEO_FORMAT_RGB &&
+         c->range == GST_VIDEO_COLOR_RANGE_0_255 &&
+         c->matrix == GST_VIDEO_COLOR_MATRIX_RGB &&
+         c->primaries == GST_VIDEO_COLOR_PRIMARIES_BT709 &&
+         c->transfer == GST_VIDEO_TRANSFER_BT709;
+}
+
+static inline float
+gtk_gst_bt1886_linear (guint8 code)
+{
+  return powf ((float) code / 255.f, 2.4f);
+}
+
+/* A per-frame bound, not a claim about total decoder/process RSS. */
+static inline gboolean
+gtk_gst_bt1886_frame_size (gsize width, gsize height, gsize *size)
+{
+  gsize pixels;
+  return width > 0 && height > 0 &&
+         g_size_checked_mul (&pixels, width, height) &&
+         g_size_checked_mul (size, pixels, 4 * sizeof (float)) &&
+         *size <= 256 * 1024 * 1024;
+}
