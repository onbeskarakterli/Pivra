+/* CPU reference implementation, opt-in only. No GL readback or YUV relabeling.
+ * A shipping implementation should represent this display EOTF in GDK and
+ * apply it identically to CPU/GL/DMABUF, rather than forcing CPU negotiation.
+ */
+static GdkTexture *
+gtk_gst_sink_bt1886_texture (GtkGstSink *self, GstVideoFrame *frame)
+{
+  const gsize width = frame->info.width;
+  const gsize height = frame->info.height;
+  gsize size;
+  float *data;
+  static float lut[256];
+  static gsize initialized;
+  GBytes *bytes;
+  GdkMemoryTextureBuilder *builder;
+  GdkTexture *texture;
+
+  if (!gtk_gst_bt1886_frame_size (width, height, &size) ||
+      !(data = g_try_malloc (size)))
+    {
+      GST_ELEMENT_ERROR (self, RESOURCE, NO_SPACE_LEFT,
+                         ("BT.1886 reference frame exceeds allocation budget"), (NULL));
+      return NULL;
+    }
+  if (g_once_init_enter (&initialized))
+    {
+      for (guint i = 0; i < 256; i++)
+        lut[i] = gtk_gst_bt1886_linear (i);
+      g_once_init_leave (&initialized, 1);
+    }
+  for (gsize y = 0; y < height; y++)
+    {
+      const guint8 *row = (const guint8 *) frame->data[0] +
+                         (gssize) y * frame->info.stride[0];
+      for (gsize x = 0; x < width; x++)
+        {
+          float *pixel = data + (y * width + x) * 4;
+          pixel[0] = lut[row[x * 3]];
+          pixel[1] = lut[row[x * 3 + 1]];
+          pixel[2] = lut[row[x * 3 + 2]];
+          pixel[3] = 1.f;
+        }
+    }
+  bytes = g_bytes_new_take (data, size);
+  builder = gdk_memory_texture_builder_new ();
+  gdk_memory_texture_builder_set_width (builder, width);
+  gdk_memory_texture_builder_set_height (builder, height);
+  gdk_memory_texture_builder_set_format (builder, GDK_MEMORY_R32G32B32A32_FLOAT);
+  gdk_memory_texture_builder_set_stride (builder, width * 4 * sizeof (float));
+  gdk_memory_texture_builder_set_bytes (builder, bytes);
+  gdk_memory_texture_builder_set_color_state (builder, gdk_color_state_get_srgb_linear ());
+  texture = gdk_memory_texture_builder_build (builder);
+  g_object_unref (builder);
+  g_bytes_unref (bytes);
+  return texture;
+}
