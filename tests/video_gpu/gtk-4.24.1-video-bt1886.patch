+/* BT.1886 reference display, normalized white=1 and ideal black=0. */
+static inline void
+bt1886_eotf (float v[3])
+{
+  for (int i = 0; i < 3; i++)
+    v[i] = powf (MAX (v[i], 0.f), 2.4f);
+}
+
+static inline void
+bt1886_oetf (float v[3])
+{
+  for (int i = 0; i < 3; i++)
+    v[i] = powf (MAX (v[i], 0.f), 1.f / 2.4f);
+}
