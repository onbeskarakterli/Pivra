+/* Private constructor used by video sinks. Never mutate a published state or
+ * change the interpretation of image/CSS CICP transfer 1. */
+GdkColorState *
+gdk_color_state_new_for_video_cicp (const GdkCicp *cicp, GError **error)
+{
+  GdkColorState *state = gdk_color_state_new_for_cicp (cicp, error);
+  GdkCicpColorState *self;
+
+  if (state == NULL || cicp->color_primaries != 1 || cicp->transfer_function != 1 ||
+      !((cicp->matrix_coefficients == 0 && cicp->range == GDK_CICP_RANGE_FULL) ||
+        (cicp->matrix_coefficients == 1 &&
+         (cicp->range == GDK_CICP_RANGE_FULL || cicp->range == GDK_CICP_RANGE_NARROW))))
+    return state;
+
+  /* These tuples cannot be default/builtin states; the constructor above
+   * allocates a new CICP state, so initialization remains immutable/threadsafe. */
+  g_assert (state->klass == &GDK_CICP_COLOR_STATE_CLASS);
+  self = (GdkCicpColorState *) state;
+  self->video_bt1886 = TRUE;
+  /* BT.709 and sRGB primaries coincide exactly. Avoid numerical XYZ roundtrip
+   * cross-talk, which a display inverse EOTF would amplify near black. */
+  memcpy (self->to_srgb, identity, sizeof (self->to_srgb));
+  memcpy (self->from_srgb, identity, sizeof (self->from_srgb));
+  self->eotf = bt1886_eotf;
+  self->oetf = bt1886_oetf;
+  g_free (self->name);
+  self->name = g_strdup_printf ("video-bt1886-%u/%u/%u/%u", cicp->color_primaries,
+                                cicp->transfer_function, cicp->matrix_coefficients, cicp->range);
+  return state;
+}
+
+gboolean
+gdk_color_state_is_video_bt1886 (GdkColorState *state)
+{
+  return state->klass == &GDK_CICP_COLOR_STATE_CLASS &&
+         ((GdkCicpColorState *) state)->video_bt1886;
+}
