+  g_assert_true (g_bytes_equal (bytes, again));
+  g_bytes_unref (again);
+  g_bytes_unref (bytes);
+  g_bytes_unref (input);
+  gsk_render_node_unref (copy);
+  gsk_render_node_unref (node);
+}
