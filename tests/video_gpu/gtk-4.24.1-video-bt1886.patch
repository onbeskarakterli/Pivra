+static void
+test_video_bt1886 (void)
+{
+  GdkCicp cicp = { 1, 1, 0, GDK_CICP_RANGE_FULL };
+  GdkColorState *image = gdk_color_state_new_for_cicp (&cicp, NULL);
+  GdkColorState *video = gdk_color_state_new_for_video_cicp (&cicp, NULL);
+  GdkColorState *video2 = gdk_color_state_new_for_video_cicp (&cicp, NULL);
+  float v[4] = { 0.5f, 0.5f, 0.5f, 1.f }, linear[4];
+
+  g_assert_true (gdk_color_state_is_video_bt1886 (video));
+  g_assert_false (gdk_color_state_is_video_bt1886 (image));
+  g_assert_false (gdk_color_state_equal (image, video));
+  g_assert_true (gdk_color_state_equal (video, video2));
+  gdk_color_state_convert_color (video, v, GDK_COLOR_STATE_SRGB_LINEAR, linear);
+  g_assert_cmpfloat_with_epsilon (linear[0], powf (0.5f, 2.4f), 0.00001);
+  gdk_color_state_unref (video2);
+  gdk_color_state_unref (video);
+  gdk_color_state_unref (image);
+
+  /* Full/narrow YUV retain their source metadata, HDR and image states do not
+   * acquire this video intent. */
+  cicp.matrix_coefficients = 1;
+  for (guint range = 0; range <= 1; range++)
+    {
+      cicp.range = range;
+      video = gdk_color_state_new_for_video_cicp (&cicp, NULL);
+      g_assert_true (gdk_color_state_is_video_bt1886 (video));
+      g_assert_cmpuint (gdk_color_state_get_cicp (video)->range, ==, range);
+      gdk_color_state_unref (video);
+    }
+  cicp.matrix_coefficients = 0;
+  cicp.range = GDK_CICP_RANGE_FULL;
+  for (guint transfer = 0; transfer <= 18; transfer++)
+    {
+      cicp.transfer_function = transfer;
+      video = gdk_color_state_new_for_video_cicp (&cicp, NULL);
+      if (video)
+        {
+          g_assert_cmpint (gdk_color_state_is_video_bt1886 (video), ==, transfer == 1);
+          gdk_color_state_unref (video);
+        }
+    }
+}
+
